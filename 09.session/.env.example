# MySQL 접속정보 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=node_db

# 세션 쿠키 서명 키. 유출되면 세션을 위조당할 수 있으니 임의의 긴 문자열을 쓰세요.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 비밀번호 해시에 붙이는 salt.
# ⚠️ 원래는 사용자마다 달라야 합니다. 지금은 수업 코드 그대로 전역 고정값입니다.
#    README 의 연습 과제 2번 참고.
PASSWORD_SALT=20191201
